{
  "name": "manymano",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "wrangler dev",
    "typecheck": "react-router typegen && tsc",
    "test:predeploy": "node tests/predeploy.mjs",
    "test:unit": "vitest run",
    "test:staging": "vitest run --config vitest.staging.config.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:predeploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply manymano-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply manymano-db --remote",
    "deploy": "npm run typecheck && CLOUDFLARE_ENV=production npm run build && npm run test:unit && npm run test:predeploy && wrangler deploy",
    "deploy:staging": "npm run typecheck && CLOUDFLARE_ENV=staging npm run build && npm run test:unit && npm run test:predeploy && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@react-router/dev": "8.4.0",
    "@react-router/fs-routes": "8.4.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.23",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.4.0",
    "tailwind-merge": "^3.0.2",
    "worker-mailer": "^1.2.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.0",
      "hono": "4.13.13",
      "body-parser": "2.4.0",
      "fast-uri": "3.1.9",
      "ip-address": "10.7.4",
      "postcss-selector-parser@6": "7.1.6",
      "qs": "6.16.1",
      "sharp": "0.35.5",
      "shell-quote": "1.12.0",
      "undici@7": "7.30.1",
      "undici@8": "8.12.2",
      "ws@8": "8.21.0"
    }
  }
}
