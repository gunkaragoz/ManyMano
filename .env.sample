# ManyMano — environment template.
#
# Copy to `.dev.vars` for local dev (read by `pnpm run dev` via the
# Cloudflare Vite plugin AND by `wrangler d1`):
#   cp .env.sample .dev.vars
#
# Production: plaintext vars live in `wrangler.toml` (`[vars]` /
# `[env.staging.vars]`), secrets via `wrangler secret put`. Do NOT commit
# real values — `.dev.vars` and `.env` are gitignored.
#
# REQUIRED — the app throws at request time when any of these is missing.
# There are intentionally no hardcoded fallbacks, so a rebrand or fork can
# never silently serve stale defaults.

# Canonical origin, no trailing slash. Production: your real domain.
# Local dev: the URL you open in the browser (e.g. http://localhost:5190).
# The dev server port follows this value automatically (see vite.config.ts) —
# no `--port` flag needed. An explicit `--port` CLI flag still wins.
SITE_URL="https://manymano.com"

# Brand name used in titles, meta, JSON-LD, FAQ, email footers, calendar files.
SITE_NAME="ManyMano"

# Short tagline: footer, OG/Twitter descriptions, manifest, llms.txt.
SITE_TAGLINE="Free sign-up sheets and meeting polls."

# Full description: root <meta name="description"> + SoftwareApplication JSON-LD.
SITE_DESCRIPTION="Free sign-up sheets and meeting polls. No accounts, no ads — create and share in seconds. A free Doodle and SignUpGenius alternative."

# Outbound mail identity (`from` for Resend and SMTP). No fallback — must be
# set even when no provider credentials are present (emails are then skipped,
# but config still validates).
FROM_EMAIL="ManyMano <no-reply@mail.manymano.com>"

# --- OPTIONAL — derived defaults (safe to leave empty/unset, never throws) ---
#
# When unset these fall back to values derived from the required vars above:
#   SECURITY_CONTACT → GITHUB_REPO_URL + "/issues", else mailto:FROM_EMAIL
#   ICS_UID_DOMAIN   → hostname of SITE_URL (e.g. manymano.com)
#   ICS_PRODID       → PRODID:-//{SITE_NAME}//Open Source Scheduling//EN
# Set them explicitly only to override the derived defaults.

# security.txt Contact: URL or mailto (e.g. mailto:security@example.com).
SECURITY_CONTACT="https://github.com/gunkaragoz/ManyMano/issues"

# Calendar identity (RFC 5545). UID domain = the part after `@` in VEVENT UIDs.
ICS_UID_DOMAIN="manymano.com"
# Full PRODID content line, including the `PRODID:` prefix.
ICS_PRODID="PRODID:-//ManyMano//Open Source Scheduling//EN"

# --- OPTIONAL — branding (safe to leave empty/unset) ---

# Repo link: footer GitHub icon, Organization JSON-LD `sameAs`, llms.txt.
# When empty/unset the footer GitHub icon is hidden and `sameAs` /
# the llms.txt GitHub line are omitted.
GITHUB_REPO_URL="https://github.com/gunkaragoz/ManyMano"

# Footer credit link (operator / sponsor homepage).
# Shown only when BOTH url and label are set; otherwise hidden.
FOOTER_CREDIT_URL="https://gnkz.net"
FOOTER_CREDIT_LABEL="gnkz.net"

# --- OPTIONAL — integrations (safe to leave empty in local dev) ---

# Outbound email provider: "resend" (default) or "smtp". Unknown values throw
# at request time (fail-fast, like the required vars above).
EMAIL_PROVIDER="resend"

# Resend transactional email. When empty, outbound mail is skipped and the
# app keeps working via in-browser .ics downloads + tokenized links.
RESEND_API_KEY=""

# Generic SMTP (used when EMAIL_PROVIDER="smtp"). Works with any SMTP server,
# including Amazon SES via its SMTP endpoint:
#   SMTP_HOST="email-smtp.eu-central-1.amazonaws.com"
#   SMTP_PORT="587"            # 587 = STARTTLS (default), 465 = implicit TLS
#   SMTP_USERNAME="<ses-smtp-username>"
#   SMTP_PASSWORD="<ses-smtp-password>"
#   SMTP_SECURE=""             # "true" forces implicit TLS; auto from port otherwise
# Notes: Cloudflare Workers blocks outbound port 25 — use 587 or 465.
# SMTP sends run on `cloudflare:sockets`, so they work on the deployed
# Worker and under `pnpm run dev` (workerd), but NOT under a plain Node
# runtime (no sockets API).
# When HOST/USERNAME/PASSWORD are incomplete, mail is skipped like above.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_SECURE=""

# Quota-alert baselines (optional). Defaults follow the active provider:
# Resend free (100/day, 3,000/month) vs SMTP/SES-sized (50,000/day,
# 1,500,000/month). Set these to your real SES/SMTP limits so the 80/90/100%
# webhooks below fire at the right time.
EMAIL_DAILY_LIMIT=""
EMAIL_MONTHLY_LIMIT=""

# Quota alerts (optional, server-only). Discord or Slack incoming webhook URL.
# Every sent email is counted in D1; at 80/90/100% of the active provider
# quota — and when Resend returns 429 exhausted — one webhook
# fires per threshold per period. Email alerts would be self-defeating (they
# stop working exactly when the quota is gone), hence Discord/Slack.
# When empty, counting still works (see GET /api/usage) but no push alerts.
ALERT_WEBHOOK_URL=""

# Data retention (optional). Events expire this many days after creation
# (auto-deleted on read + hourly prune). When empty/unset, defaults to 365.
# Non-numeric / non-positive values fall back to the default.
RETENTION_DAYS=""

# Reminder emails (Workers Cron Trigger, hourly scan).
# The worker sends, for events coming up:
#   1. the organizer a roster summary — 48h ahead when volunteer shifts
#      still have open spots, plus the standard reminder 12h before the
#      event starts (per-task fill like "1/3 volunteers"),
#   2. each participant with an email address a reminder for their own
#      shift(s) / the locked-in meeting time (same details as the signup mail).
# The 12h send is measured from the earliest slot start in the EVENT's
# timezone (9:00 AM assumed when slots carry no times; dedupe makes
# re-runs safe).
# Schedule lives in wrangler.toml [triggers] (hourly; production only —
# staging has none). No secret needed: the trigger runs in-worker
# (see workers/app.ts).
# GET /api/reminders remains for manual runs: ?dry-run=1 reports what would
# be sent without sending; ?date=YYYY-MM-DD overrides "tomorrow" for
# testing. Re-runs are deduped per event+date (reminder_sends table), so
# retries never double-email. The endpoint itself still needs
# REMINDER_SECRET below (fail-closed 503 when empty — an open endpoint
# would let anyone burn the email quota). Leave empty if you never call it.
REMINDER_SECRET=""

# Cloudflare Turnstile bot protection. When TURNSTILE_SECRET_KEY is empty,
# verification is skipped (local dev passthrough). In production set BOTH:
# the site key (public, echoed to the browser) and the secret (server-only).
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Comma-separated hostnames Turnstile responses are accepted for, e.g.
# "manymano.com,www.manymano.com". Required when the secret is set.
TURNSTILE_HOSTNAMES=""
